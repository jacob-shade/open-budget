# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Required for OAuth banks (Chase, Wells Fargo, ...) in production; must be registered in the Plaid dashboard.
# PLAID_REDIRECT_URI=https://localhost:5173/oauth

# Google sign-in: https://console.cloud.google.com/apis/credentials
# OAuth client type "Web application", authorized redirect URI = PUBLIC_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to sign in. Everyone else is rejected.
ALLOWED_EMAILS=
# The URL you open in the browser. Must match the Google redirect URI exactly (localhost != 127.0.0.1).
#   Docker / cargo run:  http://localhost:3000
#   Vite dev server:     http://localhost:5173
PUBLIC_URL=http://localhost:3000
# Defaults to true when PUBLIC_URL is https.
# COOKIE_SECURE=true

DATABASE_URL=sqlite://budget.db
# SQLCipher key: the whole database is AES-256 encrypted at rest. Generate with: openssl rand -hex 32
# BACK THIS UP somewhere other than this machine. If it's lost, the data cannot be recovered.
DATABASE_KEY=
PORT=3000
RUST_LOG=open_budget=debug,tower_http=info
