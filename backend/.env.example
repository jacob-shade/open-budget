# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Required for OAuth banks (Chase, Wells Fargo, ...) in production; must be registered in the Plaid dashboard.
# PLAID_REDIRECT_URI=https://localhost:5173/oauth

DATABASE_URL=sqlite://budget.db
PORT=3000
RUST_LOG=open_budget=debug,tower_http=info
